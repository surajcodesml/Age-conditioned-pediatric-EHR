  "why_24h": {
    "verdict": "prediction_time_constraint",
    "stop_before_rebuild": true,
    "reason": "--obs_window_days=1.0 in build_cohorts_pic is the landmark observation window: features = events with timestamp_days <= 1; mortality excludes deaths within 24h; los_gt7 excludes ICU stays <= 24h and predicts LOS>7 from the first day. Removing the clip without re-deriving cohorts + outcome timing widens the feature window into the outcome period (forward leakage for mortality/los_gt7). Documented as intentional in Project_Documentation (first 24h obs window) and MODEL_NEW_IMPLEMENTATION \u00a712 (widening forwards leaks; needs cohort re-derivation).",
    "not_a_convenience_default": true
  }
}